# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql+psycopg://registry:registry@localhost:5432/registry
# The registry's own API key for the seed agent (created by scripts/seed_agent.py)
# REGISTRY_API_KEY=
# Operator key for /v0/admin/* (revoke/quarantine). Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# Leave unset to disable admin endpoints.
# OPERATOR_API_KEY=<redacted>
# Jev content screen (TypeSafe API key). Publish is screened for malicious
# instructions and leaked secrets. Fails open with logging when unset.
# JEV_API_KEY=<redacted>
# JEV_GATE_ENABLED=1
# JEV_GATE_SAMPLE_RATE=1.0